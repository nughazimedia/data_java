const CACHE_NAME = 'sekolah-app-v1';
const urlsToCache = [
  'https://cbtsystem.blogspot.com/p/login.html',
  'https://cbtsystem.blogspot.com/p/dashboard.html',
  'https://cbtsystem.blogspot.com/p/absensi.html'
];

self.addEventListener('install', event => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(cache => cache.addAll(urlsToCache))
  );
});

self.addEventListener('fetch', event => {
  event.respondWith(
    caches.match(event.request).then(response => {
      return response || fetch(event.request);
    })
  );
});